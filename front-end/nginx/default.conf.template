server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Khop voi gioi han upload cua api-gateway va document-service
    # (spring.servlet.multipart.max-file-size / max-request-size = 25MB).
    # Doi o mot noi thi doi ca ba.
    client_max_body_size 25m;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};
    set $minio_upstream ${MINIO_UPSTREAM};

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # Presigned URL cua MinIO (bucket "attachments") do document-service ky theo
    # MINIO_PUBLIC_ENDPOINT = dia chi cong khai cua trang. Chu ky S3 bao gom header Host,
    # nen phai chuyen nguyen Host trinh duyet gui (kem cong neu co) va nguyen duong dan.
    location /attachments/ {
        limit_except GET HEAD {
            deny all;
        }
        proxy_pass $minio_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}

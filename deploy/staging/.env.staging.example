# ==============================================================================
# MAU BIEN MOI TRUONG CHO STAGING
#   cp .env.staging.example .env.staging   roi dien gia tri that
#   File .env.staging KHONG duoc commit, KHONG gui qua chat nhom.
#   Moi gia tri phai KHAC moi truong dev.
# ==============================================================================

# Database (1 container Postgres, 5 database)
POSTGRES_USER=dms
POSTGRES_PASSWORD=<mat-khau-manh>          # tao bang: openssl rand -hex 24

# Khoa ky JWT cua auth-service (64 ky tu hex)
JWT_SECRET_KEY=<khoa-jwt>                  # tao bang: openssl rand -hex 32

# Secret dung chung giua api-gateway va cac service phia sau
GATEWAY_SHARED_SECRET=<secret-gateway>     # tao bang: openssl rand -hex 32

# MinIO (object storage cho tep dinh kem)
MINIO_ROOT_USER=dms-minio
MINIO_ROOT_PASSWORD=<mat-khau-minio>       # tao bang: openssl rand -hex 24
MINIO_BUCKET=attachments

# Dia chi staging (dung cho CORS cua api-gateway)
STAGING_ORIGIN=https://dms.dangquocviet.io.vn

# Cong front-end tren may host (Cloudflare Tunnel tro vao http://localhost:8888)
FRONTEND_PORT=8888

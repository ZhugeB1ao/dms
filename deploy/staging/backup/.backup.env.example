# ==============================================================================
# CAU HINH SAO LUU STAGING
#   cp .backup.env.example .backup.env   roi dien gia tri that
#   File .backup.env KHONG duoc commit (da nam trong .gitignore), quyen 600:
#   chmod 600 .backup.env
# ==============================================================================

# Mat khau ma hoa ban sao luu (AES-256). MAT MAT KHAU NAY = KHONG DOC DUOC BAN SAO LUU.
# Luu mot ban trong trinh quan ly mat khau CA NHAN, KHAC voi noi luu ban sao luu.
# Tao bang: openssl rand -hex 32
BACKUP_PASSPHRASE=<passphrase>

# So ban giu lai (ca o may va tren R2). Mac dinh 7.
BACKUP_KEEP=7

# Bucket MinIO can sao luu (phai trung MINIO_BUCKET cua staging)
MINIO_BUCKET=attachments

# --- Cloudflare R2 (noi luu NGOAI may) ----------------------------------------
# Cloudflare Dashboard -> R2 Object Storage -> tao bucket (vi du dms-backup)
# -> Manage R2 API Tokens -> Create API token: quyen "Object Read & Write",
#    chi ap dung cho DUNG bucket do (khong cap quyen toan tai khoan).
# Endpoint dang https://<ACCOUNT_ID>.r2.cloudflarestorage.com (xem trong trang R2).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=dms-backup
R2_ACCESS_KEY_ID=<access-key-id>
R2_SECRET_ACCESS_KEY=<secret-access-key>

# --- Canh bao khi sao luu THAT BAI (tuy chon) ---------------------------------
# Discord: Cai dat kenh -> Tich hop -> Webhook -> Sao chep URL Webhook.
# URL nay la BI MAT (ai co URL deu gui duoc tin vao kenh), khong commit.
# De trong = chi hien thong bao macOS tren may.
ALERT_WEBHOOK_URL=

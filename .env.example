# ==============================================================================
# CHỈ DÙNG KHI MUỐN KẾT NỐI DB CHUNG CỦA NHÓM QUA TAILSCALE
#   - Dùng DB local như bình thường: KHÔNG cần tạo .env.
#   - Dùng DB chung: cp .env.example .env, điền tài khoản được cấp,
#     rồi chạy: docker compose up -d --build
#     Muốn quay lại DB local: xóa (hoặc đổi tên) file .env.
#   - Chi tiết: HUONG_DAN_DB_CHUNG.md
# File .env không được commit. Không ghi mật khẩu thật vào file này.
# ==============================================================================


# ==============================================================================
# 1. KẾT NỐI DATABASE CHUNG (postgres-shared, 100.67.250.1:5432)
# ==============================================================================
# Máy bạn phải đăng nhập tailnet của nhóm, máy chủ DB phải đang bật.
DB_USERNAME=<tài khoản được cấp>
DB_PASSWORD=<mật khẩu được cấp>
AUTH_DB_URL=jdbc:postgresql://100.67.250.1:5432/auth_db
ACCOUNT_DB_URL=jdbc:postgresql://100.67.250.1:5432/account_db
CATEGORY_DB_URL=jdbc:postgresql://100.67.250.1:5432/category_db
DEPARTMENT_DB_URL=jdbc:postgresql://100.67.250.1:5432/department_db
ORGANIZATION_DB_URL=jdbc:postgresql://100.67.250.1:5432/organization_db


# ==============================================================================
# 2. SECRET (không bắt buộc khi dev, docker-compose.yml đã có giá trị mặc định)
# ==============================================================================
# Secret dùng chung giữa api-gateway và các service phía sau
# GATEWAY_SHARED_SECRET=
# Khóa ký JWT của auth-service (tối thiểu 64 ký tự, tạo bằng: openssl rand -hex 32)
# Môi trường thật (staging/production) BẮT BUỘC đặt giá trị mới, không dùng mặc định dev.
# JWT_SECRET_KEY=


# ==============================================================================
# 3. MINIO - object storage cho tệp đính kèm (không bắt buộc khi dev)
# ==============================================================================
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_BUCKET=attachments

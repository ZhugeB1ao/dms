
# ==============================================================================
# 1. KẾT NỐI DATABASE (Neon - Postgres trên cloud)
# ==============================================================================
# Mỗi service dùng một database riêng trên cùng host:
#   auth_db, account_db, category_db, department_db, organization_db, document_db
DB_HOST=ep-super-rain-b39lbzj6.c-4.ap-southeast-1.aws.neon.tech
DB_USERNAME=<tài khoản Neon>
DB_PASSWORD=<mật khẩu Neon>


# ==============================================================================
# 2. SECRET (không bắt buộc khi dev, docker-compose.yml đã có giá trị mặc định)
# ==============================================================================
# Secret dùng chung giữa api-gateway và các service phía sau
# GATEWAY_SHARED_SECRET=
# Khóa ký JWT của auth-service (tối thiểu 64 ký tự, tạo bằng: openssl rand -hex 32)
# Môi trường thật (staging/production) BẮT BUỘC đặt giá trị mới, không dùng mặc định dev.
# JWT_SECRET_KEY=


# ==============================================================================
# 3. MINIO - object storage cho tệp đính kèm (vẫn chạy trong Docker; không bắt buộc khi dev)
# ==============================================================================
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_BUCKET=attachments
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000
